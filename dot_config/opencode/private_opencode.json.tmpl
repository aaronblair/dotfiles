  "permission": {
    "read": {
      "~/.config/env.d": "deny",
      "~/.config/env.d/**": "deny"
    },
    "edit": {
      "~/.config/env.d": "deny",
      "~/.config/env.d/**": "deny"
    },
    "glob": {
      "~/.config/env.d": "deny",
      "~/.config/env.d/**": "deny"
    },
    "grep": {
      "~/.config/env.d": "deny",
      "~/.config/env.d/**": "deny"
    },
    "list": {
      "~/.config/env.d": "deny",
      "~/.config/env.d/**": "deny"
    },
    "external_directory": {
      "~/.config/env.d": "deny",
      "~/.config/env.d/**": "deny"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "donsetch": {
        "type": "local",
        "command": [
          "{{ if .is_macos }}/opt/homebrew/bin/donsetch{{ else }}donsetch{{ end }}",
          "mcp",
          "--supervised"
        ]
      }
    }
  },
