keybinds {
    unbind "Alt f" "Alt Left" "Alt Right"

    normal {
        bind "Super t" { NewTab; }
        bind "Super w" { CloseFocus; }
        bind "Super 1" { GoToTab 1; }
        bind "Super 2" { GoToTab 2; }
        bind "Super 3" { GoToTab 3; }
        bind "Super 4" { GoToTab 4; }
        bind "Super 5" { GoToTab 5; }
        bind "Super 6" { GoToTab 6; }
        bind "Super 7" { GoToTab 7; }
        bind "Super 8" { GoToTab 8; }
        bind "Super 9" { GoToTab 9; }

        bind "Super d" { NewPane "Right"; }
        bind "Super Shift d" { NewPane "Down"; }

        bind "Super Alt Left" { GoToPreviousTab; }
        bind "Super Alt Right" { GoToNextTab; }
    }

    shared_except "locked" {
        bind "Alt Shift f" { ToggleFloatingPanes; SwitchToMode "normal"; }
    }
}

theme "catppuccin-macchiato"
default_mode "normal"
simplified_ui true
scroll_buffer_size 100000
session_serialization true
osc8_hyperlinks true

plugins {
    zjstatus-hints location="file:~/.config/zellij/plugins/zjstatus-hints.wasm" {
        max_length 80
        overflow_str "..."
        hide_in_base_mode false
    }
}

ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}
